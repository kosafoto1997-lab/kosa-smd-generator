# Salin file ini jadi .env lalu isi nilainya.
# File .env TIDAK ikut ter-commit (sudah ada di .gitignore).

# URL web app Apps Script hasil deploy.
# Ambil dari: Apps Script > Deploy > Manage deployments > Web app URL
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/GANTI_DENGAN_ID_DEPLOY/exec

# Token bersama untuk memanggil backend.
# Harus sama persis dengan Script Property API_TOKEN di Apps Script.
# Buat yang acak minimal 32 karakter, contoh:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
VITE_API_TOKEN=GANTI_DENGAN_TOKEN_ACAK
